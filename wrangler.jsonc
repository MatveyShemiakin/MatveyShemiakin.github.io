{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matveyshemiakin-github-io",
  "main": "_worker.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/v2/*"]
  },
  "ai": {
    "binding": "AI"
  }
}