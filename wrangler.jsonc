{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matveyshemiakin-github-io",
  "main": "_worker.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*", "/v2/*", "/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OPHTHA_MERGE_LEADERBOARD",
        "class_name": "OphthaMergeLeaderboard"
      }
    ]
  },
  "exports": {
    "OphthaMergeLeaderboard": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
